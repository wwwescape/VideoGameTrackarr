IGDB_CLIENT_ID=your_igdb_client_id
IGDB_CLIENT_SECRET=your_igdb_client_secret

# Optional — enables Settings → Integrations → Steam (owned-games/playtime sync). Get a
# free key at https://steamcommunity.com/dev/apikey. Your SteamID64 isn't a secret and is
# set separately, in the app itself (Settings → Integrations), not here.
# STEAM_API_KEY=your_steam_web_api_key

# Optional — enables Settings → Integrations → IsThereAnyDeal (wishlist sale-price
# tracking, Insights → On Sale). Get a free key at https://isthereanydeal.com/apps/my/.
# ITAD_COUNTRY (two-letter code, default "US") picks which region's shops/currency prices
# come back in — separate from the app's own display-currency setting.
# ITAD_API_KEY=your_itad_api_key
# ITAD_COUNTRY=US

# Optional — enables Settings → Integrations → PlatPrices (PlayStation wishlist sale-price
# tracking, alongside ITAD's Windows/Mac/Linux/Android coverage). Application-reviewed key,
# usually issued within 1-2 business days: https://platprices.com/api-request. The FREE tier
# lets your account track any 2 PS Store regions at a time (choose them on your PlatPrices
# dashboard at platprices.com, changeable once every 24 hours), plus 1,000 requests/month.
# PLATPRICES_REGION below must be set to one of those 2 currently-tracked regions, or prices
# will reflect the wrong region's storefront — this is a limitation of PlatPrices' free
# tier, not something VGT works around for you.
# PLATPRICES_API_KEY=your_platprices_api_key
# PLATPRICES_REGION=US

# Required by the new backend/ (FastAPI) once you use anything auth-related — login will
# fail loudly with a clear error if this is unset, rather than falling back to an
# insecure default. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Optional. If unset, backend/ falls back to an in-process cache (fine for one instance).
# REDIS_URL=

# Optional. If unset, backend/ defaults to a local SQLite file under backend/db/.
# DATABASE_URL=

# Optional, JSON array of allowed origins. Defaults to ["http://localhost:3000"] (the Vite
# dev server) — only needed in production if frontend and backend are served from
# different origins, which isn't the normal deployment shape (FastAPI serves the built
# frontend itself, same-origin, post-cutover — see docs/architecture/02-roadmap.md M5).
# CORS_ORIGINS=["https://your-domain.example"]

# Optional, docker-compose.yml only. Which host port to publish the app on. Defaults to 8000.
# APP_PORT=8000
